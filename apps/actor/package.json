{
  "name": "@scouvela/actor",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build -w @scouvela/shared",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts --max-warnings=0",
    "pretest": "npm run build -w @scouvela/shared",
    "test": "vitest run",
    "bundle-shared": "node scripts/bundle-shared.mjs",
    "apify:push": "node scripts/bundle-shared.mjs && apify push"
  },
  "dependencies": {
    "@scouvela/shared": "*",
    "apify": "^3.4.2",
    "crawlee": "^3.13.5",
    "cheerio": "1.0.0-rc.12",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
