{
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "id": { "type": "string", "title": "ID" },
      "title": { "type": "string", "title": "Title" },
      "provider": { "type": "string", "title": "Provider" },
      "providerType": { "type": ["string", "null"], "title": "Provider type" },
      "opportunityType": { "type": "string", "title": "Opportunity type" },
      "description": { "type": "string", "title": "Description" },
      "countries": { "type": "array", "title": "Countries", "items": { "type": "string" } },
      "sectors": { "type": "array", "title": "Sectors", "items": { "type": "string" } },
      "targetGroups": { "type": "array", "title": "Target groups", "items": { "type": "string" } },
      "deadline": { "type": ["string", "null"], "title": "Deadline" },
      "status": { "type": "string", "title": "Status" },
      "confidence": { "type": "string", "title": "Confidence" },
      "applicationUrl": { "type": ["string", "null"], "title": "Application URL" },
      "sourceName": { "type": "string", "title": "Source name" },
      "sourceUrl": { "type": "string", "format": "uri", "title": "Source URL" },
      "scrapedAt": { "type": "string", "format": "date-time", "title": "Scraped at" }
    },
    "required": [
      "id",
      "title",
      "provider",
      "opportunityType",
      "description",
      "countries",
      "sourceUrl",
      "sourceName",
      "status",
      "scrapedAt"
    ],
    "additionalProperties": true
  },
  "views": {
    "overview": {
      "title": "Opportunities",
      "transformation": {
        "fields": [
          "title",
          "provider",
          "opportunityType",
          "countries",
          "status",
          "deadline",
          "confidence",
          "sourceName",
          "sourceUrl",
          "scrapedAt"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "title": { "label": "Title" },
          "provider": { "label": "Provider" },
          "opportunityType": { "label": "Type" },
          "countries": { "label": "Countries" },
          "status": { "label": "Status" },
          "deadline": { "label": "Deadline" },
          "confidence": { "label": "Confidence" },
          "sourceName": { "label": "Source" },
          "sourceUrl": { "label": "Source URL" },
          "scrapedAt": { "label": "Scraped" }
        }
      }
    }
  }
}
