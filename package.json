{
  "name": "scouvela",
  "version": "0.1.0",
  "private": true,
  "description": "Apify Actor that discovers public growth opportunities for African SMEs.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/ensure-local-next-cache.mjs && npm run build -w @scouvela/shared",
    "dev": "npm run dev -w @scouvela/web",
    "dev:web": "npm run dev -w @scouvela/web",
    "dev:actor": "npm start -w @scouvela/actor",
    "build": "npm run build -w @scouvela/shared && npm run build -w @scouvela/web && npm run build -w @scouvela/actor",
    "lint": "eslint packages/shared apps/actor && npm run lint -w @scouvela/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
