# Optional: Apify platform token for CLI login, remote runs, and PPE on Apify.
# Never commit a real token.
APIFY_TOKEN=

# Local live crawls of curated websites require source approval after you review
# apps/actor/SOURCES.md. Apify Store defaults can also be set in .actor/actor.json.
SCOUVELA_BOI_SOURCE_APPROVED=true
SCOUVELA_TEF_SOURCE_APPROVED=true
SCOUVELA_GEA_SOURCE_APPROVED=true
SCOUVELA_KCIC_SOURCE_APPROVED=true

# Optional fallback that approves every curated funding/opportunity source at once.
# Prefer the per-source variables above.
# SCOUVELA_FUNDING_SOURCE_APPROVED=true
